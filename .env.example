# Create this key from Bybit mainnet -> Demo Trading -> API.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# demo uses https://api-demo.bybit.com. Keep true until demo is proven.
BYBIT_DEMO=true
ENABLE_ORDER_PLACEMENT=false

# Live mode requires BYBIT_DEMO=false and this exact acknowledgement.
LIVE_TRADING_ACK=

LEVERAGE=5
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=3
MAX_TOTAL_OPEN_RISK=0.03
DAILY_MAX_NET_LOSS=0.05
MIN_REWARD_RISK=2.0
VOLUME_MULTIPLIER=1.2
UNIVERSE_SIZE=10
POLL_SECONDS=20
ORDER_RETRY_ATTEMPTS=3
RUN_ENGINE_IN_WEB=false
DATABASE_PATH=trading_bot.db
DATABASE_URL=
LOG_LEVEL=INFO

# The Demo scanner is the active symbol-selection path. Other V2 modules remain observational.
V2_INSTRUMENTATION_ENABLED=true
V2_STRUCTURE_MODE=shadow
V2_UNIVERSE_MODE=demo
V2_PORTFOLIO_MODE=shadow
V2_PLAYBOOK_MODE=shadow
V2_THESIS_MODE=off
V2_MANAGEMENT_MODE=off
# Phase-6 recovery planner assumptions. Shadow mode records decisions but never changes orders.
V2_TAKER_FEE_RATE=0.00055
V2_SLIPPAGE_RATE=0.00020
V2_MAX_FRICTION_RISK_FRACTION=0.25
SCANNER_MIN_LISTING_AGE_DAYS=30
SCANNER_MIN_TURNOVER_24H=1000000
SCANNER_MIN_OPEN_INTEREST=250000
SCANNER_MAX_SPREAD_FRACTION=0.0015
SCANNER_ANOMALY_MOVE_FRACTION=0.25
SCANNER_CANDIDATE_MAX=20
SCANNER_DEEP_ANALYSIS_MAX=10
SCANNER_ACTION_QUEUE_MAX=10
SCANNER_NEWCOMER_ADVANTAGE_FRACTION=0.05
SCANNER_EXIT_GRACE_SCANS=2
SCANNER_NEAR_ZONE_FRACTION=0.01
SCANNER_HIGH_VOLATILITY_FRACTION=0.12
SCANNER_ABNORMAL_VOLATILITY_FRACTION=0.35
SCANNER_CHURN_LIMIT_FRACTION=0.25
SCANNER_LATENCY_LIMIT_MS=15000
SCANNER_REFRESH_SECONDS=900
PORTFOLIO_LOOKBACK_HOURS=72
PORTFOLIO_MIN_OVERLAP=36
PORTFOLIO_HEALTHY_OVERLAP=60
PORTFOLIO_CLUSTER_CORRELATION=0.70
PORTFOLIO_REFRESH_SECONDS=900
PLAYBOOK_MIN_1H_CANDLES=60
PLAYBOOK_MIN_5M_CANDLES=30
PLAYBOOK_ZONE_PROXIMITY_ATR=0.25
PLAYBOOK_BREAKOUT_RETEST_MAX_AGE_HOURS=8
STRUCTURE_INTERNAL_SWING_WIDTH=2
STRUCTURE_MAJOR_SWING_WIDTH=5
STRUCTURE_ATR_PERIOD=14
STRUCTURE_ZONE_ATR_MULTIPLIER=0.15
STRUCTURE_ZONE_MIN_PRICE_FRACTION=0.0005
STRUCTURE_WEAKENED_AFTER_TOUCHES=2
STRUCTURE_BREAK_BUFFER_ATR=0.0
STRUCTURE_INVALIDATION_BUFFER_ATR=0.50
STRUCTURE_FAILED_BREAK_WINDOW=3
STRUCTURE_MAX_DEBUG_ZONES=12

# Required by the web dashboard.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Optional alerts. Leave both blank to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
