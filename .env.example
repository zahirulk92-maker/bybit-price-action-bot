# Create this key from Bybit mainnet -> Demo Trading -> API.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# demo uses https://api-demo.bybit.com. Keep true until demo is proven.
BYBIT_DEMO=true
ENABLE_ORDER_PLACEMENT=false

# Live mode requires BYBIT_DEMO=false and this exact acknowledgement.
LIVE_TRADING_ACK=

LEVERAGE=5
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=3
MAX_TOTAL_OPEN_RISK=0.03
DAILY_MAX_NET_LOSS=0.05
MIN_REWARD_RISK=1.5
VOLUME_MULTIPLIER=1.2
UNIVERSE_SIZE=10
POLL_SECONDS=20
ORDER_RETRY_ATTEMPTS=3
RUN_ENGINE_IN_WEB=false
DATABASE_PATH=trading_bot.db
DATABASE_URL=
LOG_LEVEL=INFO

# ThesisEdge Phase 0 records replay data; Phase 1 structure runs in shadow. No V2 module has order authority.
V2_INSTRUMENTATION_ENABLED=true
V2_STRUCTURE_MODE=shadow
V2_UNIVERSE_MODE=off
V2_PORTFOLIO_MODE=off
V2_PLAYBOOK_MODE=off
V2_THESIS_MODE=off
V2_MANAGEMENT_MODE=off
STRUCTURE_INTERNAL_SWING_WIDTH=2
STRUCTURE_MAJOR_SWING_WIDTH=5
STRUCTURE_ATR_PERIOD=14
STRUCTURE_ZONE_ATR_MULTIPLIER=0.15
STRUCTURE_ZONE_MIN_PRICE_FRACTION=0.0005
STRUCTURE_WEAKENED_AFTER_TOUCHES=2
STRUCTURE_BREAK_BUFFER_ATR=0.0
STRUCTURE_INVALIDATION_BUFFER_ATR=0.50
STRUCTURE_FAILED_BREAK_WINDOW=3
STRUCTURE_MAX_DEBUG_ZONES=12

# Required by the web dashboard.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Optional alerts. Leave both blank to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
