# Create this key from Bybit mainnet -> Demo Trading -> API.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# demo uses https://api-demo.bybit.com. Keep true until demo is proven.
BYBIT_DEMO=true
ENABLE_ORDER_PLACEMENT=false

# Live mode requires BYBIT_DEMO=false and this exact acknowledgement.
LIVE_TRADING_ACK=

LEVERAGE=5
RISK_PER_TRADE=0.005
MAX_OPEN_POSITIONS=3
MAX_TOTAL_OPEN_RISK=0.015
MIN_REWARD_RISK=1.5
VOLUME_MULTIPLIER=1.2
UNIVERSE_SIZE=10
POLL_SECONDS=20
ORDER_RETRY_ATTEMPTS=3
RUN_ENGINE_IN_WEB=false
DATABASE_PATH=trading_bot.db
DATABASE_URL=
LOG_LEVEL=INFO

# Required by the web dashboard.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Optional alerts. Leave both blank to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
